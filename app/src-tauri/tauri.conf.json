{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GTBox",
  "version": "1.0.0",
  "identifier": "com.guolicheng.gtbox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GTBox",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "transparent": true,
        "shadow": false
      },
      {
        "label": "translate-scraper",
        "title": "翻译抓取",
        "url": "about:blank",
        "width": 900,
        "height": 700,
        "create": false,
        "visible": false,
        "decorations": false,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "resources/bundle/plugins/": "plugins/",
      "resources/bundle/workspaces/": "workspaces/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
